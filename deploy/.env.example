# Copy to deploy/.env and adjust. Example values only: never commit real secrets.
POSTGRES_USER=dcs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dcs

LOG_LEVEL=INFO

# Host ports (always bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Providers (US-002). Roles map to provider/model; keys stay server-side.
ROLES={"script_writer":"openai/gpt-4o-mini","narrator":"elevenlabs/<voice_id>"}
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
RUN_BUDGET_USD=5
